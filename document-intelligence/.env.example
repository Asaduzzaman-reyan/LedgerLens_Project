# Environment variables must be exported by your shell; this file is a reference.
DOCINT_DATA=data
DOCINT_TOKEN=
DOCINT_EXTRACTOR=rules
# Set extractor to llm for a local Ollama OpenAI-compatible endpoint.
DOCINT_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
DOCINT_LLM_MODEL=qwen2.5:7b
DOCINT_LLM_KEY=
# Enable only for llama.cpp's JSON-object schema extension.
DOCINT_LLM_SCHEMA=0
DOCINT_EMBEDDINGS=fastembed
DOCINT_MAX_MB=30
DOCINT_MAX_UNITS=1500
DOCINT_JOB_SECONDS=3600
